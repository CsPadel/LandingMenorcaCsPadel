---
import Layout from "../layouts/Layout.astro";
import RetreatLandingHero from "../components/RetreatLandingHero";
import RoomsSelector from "../components/RoomsSelector";
import MenorcaItinerary from "../components/MenorcaItinerary";
import MenorcaWhatsIncluded from "../components/MenorcaWhatsIncluded";
import BespokeRetreats from "../components/BespokeRetreats";
import TestimonialsCarousel from "../components/TestimonialsCarousel";
import FAQ from "../components/FAQ";
import BookingDrawer from "../components/BookingDrawer";
import BookNowSection from "../components/BookNowSection";
import { SITE_URL, BRAND_URL, BRAND_LOGO_URL } from "../lib/site";

const seoTitle =
  "Menorca Padel Retreat 2026 | Luxury Padel Holiday Mediterranean | CourtSide";
const seoDescription =
  "Experience the ultimate luxury padel retreat in Menorca. 5 days of private coaching, boat tours, vineyard visits, padel tournament & gourmet dining. 30 Sep – 4 Oct 2026.";
const seoKeywords =
  "Menorca padel retreat, luxury padel holiday Menorca, padel training Mediterranean, private padel villa Spain, CourtSide Menorca, padel vacation 2026, padel coaching retreat, padel holiday Balearic Islands";

const menorcaSchema = {
  "@context": "https://schema.org",
  "@type": "TouristTrip",
  name: "CourtSide Menorca Padel Retreat 2026",
  description: seoDescription,
  url: SITE_URL,
  image: `${SITE_URL}/imagenes/EM-2.webp`,
  touristType: ["Sports Enthusiast", "Luxury Traveler"],
  duration: "P5D",
  itinerary: {
    "@type": "ItemList",
    numberOfItems: 5,
    name: "5-Day Menorca Padel Retreat Itinerary",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Arrival & Welcome — Airport transfers, check-in, seaside lunch, warm-up padel session, welcome dinner",
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Padel & Boat Tour — Morning coaching at Padelin, lunch and boat tour from Sa Punta restaurant",
      },
      {
        "@type": "ListItem",
        position: 3,
        name: "Padel & Vineyard — Court sessions, vineyard tour and lunch at Binifadet winery",
      },
      {
        "@type": "ListItem",
        position: 4,
        name: "Tournament & Sunset — Mixed doubles round-robin tournament, awards lunch, sunset tapas at Cova d'en Xoroi",
      },
      {
        "@type": "ListItem",
        position: 5,
        name: "Final Session & Farewell — Final breakfast, optional padel session, private airport transfers",
      },
    ],
  },
  provider: {
    "@type": "Organization",
    name: "CourtSide Padel Retreats",
    url: BRAND_URL,
    logo: BRAND_LOGO_URL,
    sameAs: [],
  },
  offers: [
    {
      "@type": "Offer",
      name: "Personal Suite — Menorca Padel Retreat",
      description:
        "Private suite for individuals or couples. Includes coaching, wellness, and all retreat activities.",
      price: "1850",
      priceCurrency: "GBP",
      availability: "https://schema.org/LimitedAvailability",
      validFrom: "2026-09-30",
      validThrough: "2026-10-04",
      url: `${SITE_URL}#book`,
    },
    {
      "@type": "Offer",
      name: "Full Villa — Exclusive Menorca Padel Retreat",
      description:
        "Entire villa exclusively for groups of 8–20 guests. Complete privacy with private chef and dedicated concierge team.",
      availability: "https://schema.org/LimitedAvailability",
      url: `${SITE_URL}#book`,
    },
    {
      "@type": "Offer",
      name: "Executive Retreat — C-Suite Menorca Padel Programme",
      description:
        "C-suite padel retreat with private meeting rooms, strategy sessions, and absolute discretion.",
      availability: "https://schema.org/LimitedAvailability",
      url: `${SITE_URL}#book`,
    },
  ],
  location: {
    "@type": "Place",
    name: "Menorca, Balearic Islands, Spain",
    geo: {
      "@type": "GeoCoordinates",
      latitude: "39.9496",
      longitude: "4.1183",
    },
    address: {
      "@type": "PostalAddress",
      addressRegion: "Menorca",
      addressCountry: "ES",
      addressLocality: "Balearic Islands",
    },
  },
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "Do I need padel experience?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "No. Our retreats welcome all levels — coaching is tailored from beginners building foundations to advanced players refining strategy.",
      },
    },
    {
      "@type": "Question",
      name: "Is everything included?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes. Everything in the itinerary is included — accommodation, all meals, coaching, matchplay, local transport, and activities.",
      },
    },
    {
      "@type": "Question",
      name: "Are flights and airport transfers included?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Transfers to and from Mahón Airport are included. Flights are not.",
      },
    },
    {
      "@type": "Question",
      name: "When is the next Menorca retreat?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "30 September – 4 October 2026 (4 nights, 5 days). Places are limited — early booking is advised.",
      },
    },
  ],
};

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "CourtSide Padel Retreats",
  url: BRAND_URL,
  logo: BRAND_LOGO_URL,
  description:
    "Ultra-luxury padel retreats in the world's most exclusive destinations.",
  foundingDate: "2024",
  serviceType: "Luxury Padel Retreat",
  sameAs: [],
};
---

<Layout
  title={seoTitle}
  description={seoDescription}
  keywords={seoKeywords}
  ogImage="/imagenes/EM-2.webp"
  canonical={SITE_URL}
  schema={menorcaSchema}
>
  <!-- Preload hero poster images (used as placeholder before video plays) -->
  <link
    slot="head"
    rel="preload"
    as="image"
    href="/imagenes/EM-2-mobile.webp"
    fetchpriority="high"
    media="(max-width: 767px)"
  />
  <link
    slot="head"
    rel="preload"
    as="image"
    href="/imagenes/EM-2-desktop.webp"
    fetchpriority="high"
    media="(min-width: 768px)"
  />
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(faqSchema)}
  />
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(organizationSchema)}
  />

  <main
    id="main-content"
    class="w-full min-h-screen bg-brand-dark flex flex-col relative overflow-x-hidden pt-24"
  >
    <!-- HERO: above-the-fold, client:load -->
    <RetreatLandingHero
      bgVideoSrc="/drone-menorca.mp4"
      bgMobileVideoSrc="Aquí_va__Real_drone_footage_D.webm"
      client:load
    />

    <!-- WHAT'S INCLUDED: below-the-fold, client:visible -->
    <MenorcaWhatsIncluded client:visible />

    <!-- DISCOVER OUR ROOMS: below-the-fold, client:visible -->
    <RoomsSelector client:visible />

    <!-- THE ITINERARY: below-the-fold, client:visible -->
    <MenorcaItinerary client:visible />

    <!-- BESPOKE RETREATS: below-the-fold, client:visible -->
    <BespokeRetreats client:visible />

    <!-- TESTIMONIALS: below-the-fold, client:visible -->
    <TestimonialsCarousel client:visible />

    <!-- FAQ: below-the-fold, client:visible -->
    <FAQ theme="light" client:visible />

    <!-- ========== BOOK NOW CTA ========== -->
    <BookNowSection client:visible />

    <BookingDrawer client:load />
  </main>
</Layout>
