---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Page Not Found | CourtSide Padel Retreats"
  description="The page you are looking for does not exist. Return to the CourtSide Menorca padel retreat homepage."
>
  <main id="main-content" class="w-full min-h-screen bg-brand-dark flex flex-col items-center justify-center px-6 text-center">

    <p class="text-xs uppercase tracking-[0.3em] text-brand-gold font-semibold mb-6">Error 404</p>

    <h1 class="text-8xl md:text-[12rem] font-light text-brand-light/10 leading-none tracking-tighter select-none" aria-hidden="true">
      404
    </h1>

    <h2 class="text-3xl md:text-4xl font-light text-brand-light tracking-wide -mt-4 md:-mt-8 mb-6">
      Page Not Found
    </h2>

    <p class="text-brand-light/50 text-lg max-w-md mx-auto mb-12 leading-relaxed">
      The page you are looking for does not exist or has been moved.
    </p>

    <a
      href="/"
      class="inline-flex items-center gap-3 px-10 py-4 border border-brand-gold text-brand-gold font-semibold uppercase tracking-widest text-sm hover:bg-brand-gold hover:text-brand-dark transition-colors duration-300"
    >
      Return to Homepage
    </a>

  </main>
</Layout>
